# gd-relay.env.example -- the environment /etc/default/gd-relay carries for
# gd-relay.service. Copy the installed file to /etc/default/gd-relay and fill
# all three values in; the unit fails fast when the first two are missing.
#
# All three are resource names, never secrets: the listener's credential is
# the VM's managed-identity token, fetched from the instance identity
# endpoint at runtime and refreshed on every control-channel reconnect.

# The relay namespace host the hybrid connection lives in, as written to the
# laptop's engine address record at deploy time.
# GD_RELAY_NAMESPACE=<name>.servicebus.windows.net

# The hybrid connection name the relay couple meets on, matching the
# laptop-side engine address record's hybrid_connection.
# GD_RELAY_HYBRID_CONNECTION=gd-<name>

# The docker daemon address this listener bridges rendezvous pipes to. The
# default is the mTLS daemon's loopback listener; override only when the
# daemon answers elsewhere on the VM.
# GD_RELAY_TARGET=127.0.0.1:2376
