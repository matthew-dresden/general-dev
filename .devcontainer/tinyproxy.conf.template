
User __USER__
Group __GROUP__

Port __LISTEN_PORT__
Bind 0.0.0.0

Timeout 600
MaxClients 100
StartServers 5
MinSpareServers 2
MaxSpareServers 10
MaxRequestsPerChild 0

LogFile "__LOG_DIR__/tinyproxy.log"
LogLevel Info

PidFile "__LOG_DIR__/tinyproxy.pid"

Allow 127.0.0.1
Allow ::1
Allow 192.168.0.0/16
Allow 172.16.0.0/12
Allow 10.0.0.0/8

Upstream http __UPSTREAM_HOST__:__UPSTREAM_PORT__ "."

ConnectPort 443
ConnectPort 563
ConnectPort 4318
ConnectPort 8080
ConnectPort 8443
ConnectPort 9418

DisableViaHeader Yes
