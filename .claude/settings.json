{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/deny_bypass.py"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "devcontainer": {
      "source": {
        "source": "directory",
        "path": ".claude/plugins/devcontainer"
      }
    }
  },
  "enabledPlugins": {
    "devcontainer@devcontainer": true
  }
}
