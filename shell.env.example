# Example shell.env. Copy to shell.env and replace each bracketed value.
#
#   cp shell.env.example shell.env
#
# shell.env is gitignored: it holds per-developer identity and configuration
# only, never a credential. Sourced by every shell in the container (.bashrc
# and .zshenv), and published to Parameter Store by `make push-secrets` for
# remote builds. A credential belongs in the hostcreds manifest instead
# (.devcontainer/hostcreds.map.json; `make init` creates it from its
# committed example): `make creds-init` stores each keychain item it names,
# and `make push-creds` resolves every entry on this machine and pushes it
# into the container, where shell startup exports it automatically.
#
# Filling this out is documented in docs/environment-files.md, including which
# values differ on macOS, Linux and WSL.

########################
# Identity, always set
########################
# Shown in prompts and used by tooling that labels work by developer.
export DEVELOPER_NAME='<Your Name>'
# Git identity written into the container's global git config.
export GIT_USER='<your-git-username>'
export GIT_USER_EMAIL='<you@example.com>'
# Host of your git provider, without scheme. Used for the credential helper
# and the SSH->HTTPS rewrite.
export GIT_PROVIDER_URL='github.com'
# Branch new work is cut from; provisioning fails fast if unset.
export DEFAULT_GIT_BRANCH='main'

##############################
# AWS, set AWS_CONFIG_ENABLED
##############################
# 'true' generates ~/.aws/config from .devcontainer/aws-profile-map.json.
# Set 'false' if this project needs no AWS profiles; the step is then skipped.
export AWS_CONFIG_ENABLED='true'
export AWS_DEFAULT_OUTPUT='json'

##########
# Shell
##########
# Marks the shell as running inside the devcontainer.
export DEVCONTAINER='true'
# Sourced by non-interactive bash. Path is inside the container, not the host.
export BASH_ENV='/workspaces/<your-repo-name>/shell.env'
export PAGER='cat'

# Some container tooling exports GIT_EDITOR; unset so git uses the editor
# you configure.
unset GIT_EDITOR

###########################################
# Host proxy, leave disabled unless needed
###########################################
# Only relevant behind a corporate proxy. When 'true', HOST_PROXY_URL must be
# set and reachable, or provisioning fails fast. See docs/environment-files.md
# for the host-specific address to use on macOS, Linux and WSL.
export HOST_PROXY='false'
export HOST_PROXY_URL=''
export HTTP_PROXY=''
export HTTPS_PROXY=''
export NO_PROXY='localhost,127.0.0.1,.local,169.254.169.254'
# Lowercase variants: some tools read only these.
export http_proxy=''
export https_proxy=''
export no_proxy='localhost,127.0.0.1,.local,169.254.169.254'

##############################
# Project-specific (optional)
##############################
# Anything else your project needs that is not a credential. A credential
# belongs in the hostcreds manifest instead (.devcontainer/hostcreds.map.json;
# `make init` creates it from its committed example): add an entry named
# after the environment variable it exports, run `make creds-init` to store
# it in the keychain, and `make push-creds` to deliver it into the container,
# where shell startup exports it the same way the values above load.
# export DEVBENCH_LOG_LEVEL='info'

##############################################
# Model provider MCP wrapper values (optional)
##############################################
# The committed opencode MCP wrappers (.devcontainer/opencode/bin/) read
# every organization-specific value from the environment at spawn time and
# fail fast naming the variable when one is missing. Set the ones your
# MCPs need here; a wrapper whose values are absent simply fails at first
# use (and the postcreate prints a provisioning-time notice). All values
# below are placeholders: nothing here names a real organization.
#
# Base prefix of the organization's SSM parameters. The github MCP wrapper
# reads "${SSM_ORG_PREFIX}/github/github-app/{app-id,private-key}" and the
# azure-devops wrappers read
# "${SSM_ORG_PREFIX}/azure-devops/opencode-pat[-expires]".
# export SSM_ORG_PREFIX='/<your-org-parameter-base>'
#
# Base prefix of the context7 parameters; the wrapper reads
# "${SSM_CONTEXT7_PREFIX}/api-key".
# export SSM_CONTEXT7_PREFIX='/<your-context7-parameter-base>'
#
# The login the GitHub App installation lives under (the github MCP wrapper
# authenticates to that installation).
# export GITHUB_APP_TARGET='<your-github-login>'
#
# The Azure DevOps organization and the identity the PAT belongs to.
# export ADO_ORG='<your-ado-organization>'
# export ADO_USER='<you@example.com>'
#
# The github/github-mcp-server release tag (without the leading v) that
# postcreate downloads the MCP server binary from; required only because
# the download needs a version, not an organization value.
# export GITHUB_MCP_SERVER_VERSION='<release-tag>'
#
# The AWS region every wrapper's SSM read runs in. Also export it uncommented
# if you use any of the wrappers above; the wrappers require it.
# export AWS_REGION='us-east-1'
#
# Provider API keys (ZAI_API_KEY, OPENROUTER_API_KEY) are NOT set here: they
# ride the hostcreds manifest like every credential. See the paragraph above.

##################################################
# Remote docker engine (only if you use one)
##################################################
# Read by the laptop-side scripts in .devcontainer/remote-docker. They live
# here rather than in the committed config.env so no real identifier is ever
# in git. Leave unset if you only build against a local docker engine.
# The EC2 instance id is recorded in the per-instance id store
# (~/.docker/certs/<name>/instance-id) by `make instance-link INSTANCE=<name>`,
# which the remote targets read; the line below stays commented unless the
# setup renderer populated it. Do not set it by hand here.
# export REMOTE_INSTANCE_ID='<ec2-instance-id>'
# export REMOTE_AWS_REGION='us-east-1'
# export REMOTE_AWS_PROFILE='default'
# `make connect-start` (what `make remote` calls) picks the transport from
# the engine's own kind, read off the address block resolution exports: an
# ssh engine (remote-instances/<name>/engine.json) opens a managed
# `ssh -N -L` forward; an azure engine opens the azure relay forward; an
# EC2 instance opens the SSM port forward, the
# default the kind dispatch runs when no KIND line names the engine ssh or
# azure. DEVCONTAINER_TRANSPORT is a guard on that dispatch, never the
# selector: an ssh engine needs no variable at all. Set, the value must
# agree with the kind ('ssm' behind an EC2 instance, 'ssh' behind an ssh
# engine, 'relay' behind an azure engine) or `make connect-start` refuses
# naming the conflict; any other value fails fast, naming the value it
# rejected and the accepted values. The full variable reference lives in
# docs/environment-files.md's "Transport" section.
# export DEVCONTAINER_TRANSPORT='ssm'
