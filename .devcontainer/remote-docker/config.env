# Configuration for the remote-docker scripts (laptop side).
# Every value can be overridden by exporting the variable before running a
# script; the `: "${VAR:=...}"` form only assigns when the variable is unset.

# EC2 instance running the Docker engine (us-east-1, sandbox account)
: "${REMOTE_INSTANCE_ID:=<ec2-instance-id>}"
: "${REMOTE_AWS_REGION:=us-east-1}"
: "${REMOTE_AWS_PROFILE:=default}"

# SSH-over-SSM tunnel identity
: "${REMOTE_SSH_ALIAS:=general-dev-remote}"
: "${REMOTE_USER:=ubuntu}"
# Private key matching the EC2 key pair "<your-key-pair-name>".
# Set REMOTE_SSH_KEY_PATH in your environment if yours lives elsewhere.
: "${REMOTE_SSH_KEY_PATH:=${HOME}/.ssh/<your-key-pair-name>.pem}"

# Docker context name used by the docker CLI and VS Code Dev Containers
: "${REMOTE_DOCKER_CONTEXT:=general-dev-remote}"
# Context to return to on disconnect (this machine's local engine). Typically
# "orbstack" on macOS and "default" on Linux; `make disconnect` lists the
# available names if this one does not exist.
: "${LOCAL_DOCKER_CONTEXT:=orbstack}"

# Timeouts (seconds)
: "${REMOTE_SSH_CONNECT_TIMEOUT:=30}"

# ---------------------------------------------------------------------------
# Host proxy (tinyproxy), used only behind a corporate proxy. Drives the
# `make proxy-*` targets. TINYPROXY_UPSTREAM_HOST has no sensible default —
# leave it empty and the daemon fails fast telling you what to export.
# ---------------------------------------------------------------------------
: "${TINYPROXY_UPSTREAM_HOST:=}"
: "${TINYPROXY_UPSTREAM_PORT:=8080}"
# Port tinyproxy listens on; must match the port in HOST_PROXY_URL in shell.env.
: "${TINYPROXY_PORT:=3128}"
: "${TINYPROXY_READINESS_TIMEOUT:=10}"
: "${TINYPROXY_STOP_TIMEOUT:=10}"
# State directory (pid, log, generated config). Override to run more than one.
: "${TINYPROXY_STATE_DIR:=${HOME}/.devcontainer-proxy}"
